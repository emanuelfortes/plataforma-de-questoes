# Copie para .env.local e preencha.

# Banco (Turso). Sem estas variáveis o projeto usa o arquivo local.db (bom para desenvolver).
# turso db show plataforma-questoes --url
TURSO_DATABASE_URL=file:local.db
# turso db tokens create plataforma-questoes
TURSO_AUTH_TOKEN=

# Better Auth. Gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
BETTER_AUTH_URL=http://localhost:3000
