# Copie para .env.local e preencha.

# Banco (Turso). Sem estas variáveis o projeto usa o arquivo local.db (bom para desenvolver).
# turso db show plataforma-questoes --url
TURSO_DATABASE_URL=file:local.db
# turso db tokens create plataforma-questoes
TURSO_AUTH_TOKEN=

# Better Auth. Gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-longo-e-aleatorio
BETTER_AUTH_URL=http://localhost:3000

# Área do dono (/admin): importar questões e gerar o prompt de IA. E-mails separados por vírgula.
# A pessoa precisa criar a conta normalmente no site com esse e-mail.
ADMIN_EMAILS=

# E-mail: recuperar senha e confirmar e-mail. Sem nenhum serviço, os e-mails só aparecem no terminal.
# Opção 1, Gmail (sem domínio próprio, até ~500 por dia). Exige verificação em duas etapas
# na conta Google e uma senha de app: myaccount.google.com/apppasswords
GMAIL_USUARIO=
GMAIL_SENHA_APP=
# Opção 2, Resend (exige domínio próprio verificado para enviar a qualquer pessoa).
# RESEND_API_KEY=
# EMAIL_REMETENTE=Plataforma de Questões <nao-responda@seudominio.com.br>

# Assinatura (Mercado Pago). Use a aplicação "Nóbrega Questões" em mercadopago.com.br/developers.
# Access Token: Credenciais de produção (ou de teste, para testar). Começa com APP_USR-.
MP_ACCESS_TOKEN=
# Segredo do webhook: Suas integrações > Webhooks > Assinatura secreta.
# URL do webhook: https://riccardonobrega.com/api/mercadopago/webhook (eventos de Planos e assinaturas).
MP_WEBHOOK_SECRET=
